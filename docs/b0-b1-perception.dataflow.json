{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "全屋 Agent：B1 預錄影片到可追溯回答的資料流",
    "subtitle": "感知只提出候選；B0 決定是否接受、如何投影，以及何時 abstain",
    "output": "docs/b0-b1-perception.dataflow.html",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [1080, 600],
    "views": [
      {
        "id": "perception-path",
        "label": "感知候選路徑",
        "focus": ["recorded_video", "frame_gate", "detector", "event_extractor", "claim_candidate"],
        "note": "原始影格保持 transient；detector/tracker/event extractor 都不能寫入狀態。"
      },
      {
        "id": "commit-path",
        "label": "提交與投影",
        "focus": ["claim_candidate", "claim_commit", "session_ledger", "relation_projection"],
        "note": "唯一 mutation 經過 deterministic commit；重複、衝突、cycle 與次序在此處處理。"
      },
      {
        "id": "answer-semantics",
        "label": "回答語意",
        "focus": ["relation_projection", "scoped_answer"],
        "note": "key → bag → sofa 是 derived estimate；不能虛構觀察到 key 自己移動。"
      }
    ]
  },
  "stages": [
    { "label": "離線輸入" },
    { "label": "B1 感知提案" },
    { "label": "B0 admission" },
    { "label": "B0 狀態" },
    { "label": "查詢輸出" }
  ],
  "nodes": [
    {
      "id": "recorded_video",
      "type": "external",
      "label": "預錄 D0 影片",
      "sublabel": "allowlisted local D0",
      "tag": "UNTRUSTED DATA",
      "stage": 0,
      "row": 0,
      "width": 144
    },
    {
      "id": "validated_config",
      "type": "security",
      "label": "Validated Config",
      "sublabel": "hash · thresholds · zones",
      "tag": "CONTROL",
      "stage": 0,
      "row": 2,
      "width": 144
    },
    {
      "id": "frame_gate",
      "type": "backend",
      "label": "Frame + Motion Gate",
      "sublabel": "decode；影格不持久化",
      "tag": "B1 PROPOSED",
      "stage": 1,
      "row": 0,
      "width": 160
    },
    {
      "id": "detector",
      "type": "backend",
      "label": "YOLO Detector",
      "sublabel": "boxes = model reports",
      "tag": "REPLACEABLE",
      "stage": 1,
      "row": 1,
      "width": 160
    },
    {
      "id": "event_extractor",
      "type": "backend",
      "label": "Tracker + Event Extractor",
      "sublabel": "move / contain hypotheses",
      "tag": "NO COMMIT",
      "stage": 1,
      "row": 2,
      "width": 192
    },
    {
      "id": "claim_candidate",
      "type": "messagebus",
      "label": "ClaimCandidate",
      "sublabel": "provenance + epistemic status",
      "tag": "CANONICAL CONTRACT",
      "stage": 2,
      "row": 0,
      "width": 184
    },
    {
      "id": "claim_commit",
      "type": "security",
      "label": "Deterministic Commit",
      "sublabel": "accept · reject · conflict",
      "tag": "ONLY MUTATION",
      "stage": 2,
      "row": 2,
      "width": 184
    },
    {
      "id": "session_ledger",
      "type": "database",
      "label": "Session Ledger",
      "sublabel": "accepted claims；replayable",
      "tag": "NOT WORLD TRUTH",
      "stage": 3,
      "row": 0,
      "width": 164
    },
    {
      "id": "relation_projection",
      "type": "backend",
      "label": "Relation Projection",
      "sublabel": "inside + at_zone + validity",
      "tag": "REBUILDABLE",
      "stage": 3,
      "row": 2,
      "width": 164
    },
    {
      "id": "scoped_answer",
      "type": "frontend",
      "label": "Scoped AnswerTrace",
      "sublabel": "status + evidence trace",
      "tag": "READ BOUNDARY",
      "stage": 4,
      "row": 1,
      "width": 192
    }
  ],
  "flows": [
    { "from": "recorded_video", "to": "frame_gate", "label": "transient frames", "classification": "raw media", "variant": "dashed", "route": "straight", "labelAt": [212, 200] },
    { "from": "frame_gate", "to": "detector", "label": "selected frames", "classification": "pixels", "variant": "default", "route": "straight", "labelAt": [315, 200] },
    { "from": "detector", "to": "event_extractor", "label": "boxes + confidence", "classification": "model report", "variant": "dashed", "route": "straight", "labelAt": [315, 314] },
    { "from": "event_extractor", "to": "claim_candidate", "label": "event hypothesis", "classification": "untrusted claim", "variant": "emphasis", "labelAt": [425, 314] },
    { "from": "claim_candidate", "to": "claim_commit", "label": "typed candidate", "classification": "provenanced", "variant": "security", "route": "straight", "labelAt": [530, 271] },
    { "from": "claim_commit", "to": "session_ledger", "label": "AcceptedClaim", "classification": "validated report", "variant": "security" },
    { "from": "session_ledger", "to": "relation_projection", "label": "accepted sequence", "classification": "session scoped", "variant": "emphasis", "route": "straight", "labelAt": [745, 271] },
    { "from": "relation_projection", "to": "scoped_answer", "label": "traceable estimate", "classification": "derived answer", "variant": "emphasis" },
    { "from": "validated_config", "to": "detector", "label": "resolved model config", "classification": "versioned control", "variant": "security", "route": "vertical-channel", "channelX": 205, "labelAt": [205, 325] }
  ]
}
