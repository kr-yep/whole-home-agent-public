{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Whole Home Agent — Evidence-Bound Prerecorded Replay Flow",
    "output": "docs/b0-b1-perception.dataflow.html",
    "animation": "none",
    "quality_profile": "showcase",
    "viewBox": [
      1100,
      700
    ],
    "views": [
      {
        "id": "answer-path",
        "label": "Answer path",
        "focus": [
          "d0_bundle",
          "validated_replay",
          "perception_relations",
          "semantic_core",
          "scoped_demo"
        ],
        "note": "Trace the fixed replay into a fixture/run/as-of-scoped answer."
      },
      {
        "id": "evidence-status",
        "label": "Evidence and failure",
        "focus": [
          "validated_replay",
          "perception_relations",
          "semantic_core",
          "run_receipt"
        ],
        "note": "Raw frames remain transient; failures and abstentions become diagnostics, not partial truth."
      },
      {
        "id": "control-lane",
        "label": "Control lane",
        "focus": [
          "policy_control",
          "validated_replay",
          "semantic_core"
        ],
        "note": "Proposed policy restricts inputs; deterministic code alone admits semantic claims."
      }
    ]
  },
  "stages": [
    {
      "label": "Source / Authority"
    },
    {
      "label": "Validate / Select"
    },
    {
      "label": "Perceive / Infer"
    },
    {
      "label": "Commit / Project"
    },
    {
      "label": "Query / Present"
    }
  ],
  "nodes": [
    {
      "id": "d0_bundle",
      "type": "external",
      "label": "Fixed D0 Bundle",
      "stage": 0,
      "row": 0,
      "width": 150,
      "tag": "hash-pinned"
    },
    {
      "id": "policy_control",
      "type": "security",
      "label": "Proposed Policy",
      "stage": 0,
      "row": 3,
      "width": 150,
      "tag": "OPERATE disabled"
    },
    {
      "id": "validated_replay",
      "type": "security",
      "label": "Validated Replay",
      "stage": 1,
      "row": 0,
      "width": 160,
      "tag": "fail closed"
    },
    {
      "id": "perception_relations",
      "type": "backend",
      "label": "Perception + Relations",
      "stage": 2,
      "row": 0,
      "width": 170,
      "tag": "may abstain"
    },
    {
      "id": "semantic_core",
      "type": "security",
      "label": "B0 Semantic Core",
      "stage": 3,
      "row": 0,
      "width": 165,
      "tag": "memory only"
    },
    {
      "id": "scoped_demo",
      "type": "frontend",
      "label": "Scoped Query + Demo",
      "stage": 4,
      "row": 0,
      "width": 165,
      "tag": "no upload"
    },
    {
      "id": "run_receipt",
      "type": "backend",
      "label": "Run Receipt",
      "stage": 4,
      "row": 3,
      "width": 155,
      "tag": "diagnostic"
    }
  ],
  "flows": [
    {
      "id": "bundle_to_replay",
      "from": "d0_bundle",
      "to": "validated_replay",
      "label": "MP4 + metadata",
      "classification": "D0 synthetic",
      "variant": "emphasis",
      "labelAt": [
        205,
        200
      ]
    },
    {
      "id": "replay_to_perception",
      "from": "validated_replay",
      "to": "perception_relations",
      "label": "selected RGB frames",
      "classification": "transient",
      "variant": "emphasis",
      "labelAt": [
        420,
        200
      ]
    },
    {
      "id": "perception_to_core",
      "from": "perception_relations",
      "to": "semantic_core",
      "label": "estimated candidates",
      "classification": "provenance-bound",
      "variant": "emphasis",
      "labelAt": [
        639,
        200
      ]
    },
    {
      "id": "core_to_demo",
      "from": "semantic_core",
      "to": "scoped_demo",
      "label": "answer + evidence chain",
      "classification": "read-only",
      "variant": "emphasis",
      "labelAt": [
        853,
        200
      ]
    },
    {
      "id": "policy_to_replay",
      "from": "policy_control",
      "to": "validated_replay",
      "label": "fixed D0 allowlist",
      "classification": "control / authority",
      "variant": "security",
      "route": "bottom-channel",
      "toSide": "bottom"
    },
    {
      "id": "replay_failure",
      "from": "validated_replay",
      "to": "run_receipt",
      "label": "failure → no session",
      "classification": "fail closed",
      "variant": "security",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "labelAt": [
        440,
        470
      ]
    },
    {
      "id": "perception_diagnostics",
      "from": "perception_relations",
      "to": "run_receipt",
      "label": "abstentions + lag",
      "classification": "diagnostic",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "labelAt": [
        740,
        420
      ]
    },
    {
      "id": "demo_receipt",
      "from": "scoped_demo",
      "to": "run_receipt",
      "label": "counts + timings",
      "classification": "run receipt",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelAt": [
        1030,
        340
      ]
    }
  ]
}
