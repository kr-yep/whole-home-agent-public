# Python environments and generated package state
.venv/
.venv-cvpdl/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local configuration, credentials, and secrets
.env
.env.*
!.env.example
!.env.template
.secrets/
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Local databases and durable stores (not part of B0)
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
.whole-home-agent/

# Model weights and generated ML artifacts
weights/
models/weights/
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.safetensors
*.engine
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Raw media, recordings, and evidence payloads
data/raw/
media/raw/
recordings/
evidence/
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a

# Tiny project-generated D0 replay media may be versioned only with a validated
# manifest under this exact public allowlist. The release auditor enforces it.
!examples/media/generated/*.mp4
!examples/media/generated/*.mkv
!examples/media/generated/*.manifest.json
!examples/media/generated/*.annotations.json

# M18 permits only this bounded, manifest-verified project-generated PNG slice.
!examples/media/generated/d1_vector_v1/
!examples/media/generated/d1_vector_v1/*.png

# Runtime outputs and local diagnostics
var/
runtime/
runs/
outputs/
artifacts/
run-receipts/
*.log
*.visual-check.*
.tmp/
tmp/
scratch/

# External datasets are local-only until license and redistribution are reviewed.
datasets/
data/external/

# Small public/synthetic semantic fixtures are intentionally versioned.
!tests/fixtures/**/*.json
!examples/fixtures/**/*.json

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Live2D 模型自備，不進版控（體積大，而且同人模型授權多半不明）
web/live2d/
# Nailong's illustration is committed: unlike the Live2D model it is the
# project's own generated art, with no upstream terms attached, and nothing
# anywhere can fetch it.
!web/characters/**/*.png

# An interrupted weight download. "*.onnx" above does not match it, and it is
# not something anyone means to commit.
models/*.part
